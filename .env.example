# ────────────────────────────────────────────────────────────────────────────
# iCOM Group — Environment variables
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored. Never commit real keys.
# ────────────────────────────────────────────────────────────────────────────

# ── Brevo (transactional email) ────────────────────────────────────────────
# Sign up at https://app.brevo.com  →  SMTP & API  →  API Keys  →  Generate
# Free tier: 300 emails/day. EU-hosted (Paris). DSGVO-konform.
BREVO_API_KEY=

# Verified sender — must be an email on a domain you've authenticated in Brevo
# (SPF + DKIM via DNS). Until verified, Brevo will reject the send.
# Suggested: kontakt@icom-group.net
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="iCOM Group"

# ── Where contact-form submissions are delivered ───────────────────────────
CONTACT_RECIPIENT_EMAIL=fb@fb-re.de

# ── Analytics ──────────────────────────────────────────────────────────────
# Google Analytics ID, optional. Falls leer → kein GA-Tag.
NEXT_PUBLIC_GA_ID=
